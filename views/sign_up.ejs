<%- include('partials/header', { 
    title: title, 
    pageStyle: 'sign_up.css', 
    bodyClass: 'signup-body',
    metaDescription: 'Crie sua conta no Picoca Review e comece a organizar suas séries, acompanhar notícias e avaliar suas séries favoritas.'
}) %>
    <main>
      <h3 class="signup-title">Faça o seu cadastro:</h3>
      <section class="formulario-cadastro">
        <form class="row g-3 needs-validation" novalidate action="/signup" method="POST">
            <% if (typeof error === 'string' && error) { %>
                <div class="alert alert-danger text-center col-12" role="alert">
                    <%= error %>
                </div>
            <% } %>
          <div class="col-md-4"> <label for="firstName" class="form-label">Primeiro nome</label>
            <input type="text" class="form-control" id="firstName" name="firstName" value="<%= input && input.firstName ? input.firstName : '' %>" required />
            <div class="valid-feedback">Ok!</div>
            <div class="invalid-feedback">Por favor, insira seu primeiro nome.</div>
          </div>

          <div class="col-md-4">
            <label for="lastName" class="form-label">Último nome</label>
            <input type="text" class="form-control" id="lastName" name="lastName" value="<%= input && input.lastName ? input.lastName : '' %>" required />
            <div class="valid-feedback">Ok!</div>
             <div class="invalid-feedback">Por favor, insira seu último nome.</div>
          </div>

          <div class="col-md-4">
            <label for="username" class="form-label">Username</label>
            <div class="input-group has-validation"> <span class="input-group-text">@</span>
              <input
                type="text"
                class="form-control"
                id="username" 
                name="username"
                aria-describedby="inputGroupPrepend"
                value="<%= input && input.username ? input.username : '' %>"
                pattern="^[a-zA-Z0-9_.-]*$" required
              />
              <div class="invalid-feedback">Escolha um nome de usuário (letras, números, _, ., -).</div>
            </div>
          </div>

          <div class="col-md-6">
            <label for="validationEmail" class="form-label">Email</label>
            <input
              type="email"
              class="form-control"
              id="validationEmail"
              name="email"
              value="<%= input && input.email ? input.email : '' %>"
              required
            />
            <div class="invalid-feedback">
              Por favor, insira um email válido.
            </div>
          </div>

          <div class="col-md-6">
            <label for="validationEmailConfirm" class="form-label"
              >Confirmar Email</label
            >
            <input
              type="email"
              class="form-control"
              id="validationEmailConfirm"
              name="emailConfirm" 
              required
            />
            <div class="invalid-feedback">Os emails não correspondem ou é inválido.</div>
          </div>

          <div class="col-md-6">
            <label for="validationPassword" class="form-label">Senha</label>
            <input
              type="password"
              class="form-control"
              id="validationPassword"
              name="password"
              minlength="8" required
            />
            <div class="invalid-feedback">
              A senha deve ter no mínimo 8 caracteres.
            </div>
          </div>

          <div class="col-md-6">
            <label for="validationPasswordConfirm" class="form-label"
              >Confirmar Senha</label
            >
            <input
              type="password"
              class="form-control"
              id="validationPasswordConfirm"
              name="passwordConfirm"
              minlength="8"
              required
            />
            <div class="invalid-feedback">As senhas não correspondem.</div>
          </div>

          <div class="col-12">
            <div class="form-check">
              <input
                class="form-check-input"
                type="checkbox"
                value="" id="invalidCheck"
                name="terms"
                required
              />
              <label class="form-check-label" for="invalidCheck">
                Concordo com os Termos e Condições.
              </label>
              <div class="invalid-feedback">
                Você deve concordar antes de enviar.
              </div>
            </div>
          </div>

          <div class="col-12">
            <button class="btn btn-primary w-100" type="submit">Cadastrar</button>
          </div>
           <p class="mt-3 text-center col-12">Já tem uma conta? <a href="/login">Faça Login</a></p>
        </form>
      </section>
    </main>
<%- include('partials/footer', { pageScript: 'signup_client_validation.js' }) %>