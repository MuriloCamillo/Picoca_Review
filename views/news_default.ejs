<%- include('partials/header', { 
    title: title, 
    pageStyle: 'news.css', 
    bodyClass: 'news-body',
    metaDescription: news && news.summary ? news.summary.substring(0, 160) : (news ? news.title : title)
}) %>
    <main class="container mt-5 pt-4">
      <% if (news) { %>
        <section class="news">
            <p class="back-link-container">
              <a class="journal-link" href="/journal">
                <i class="bi bi-arrow-left"></i> Voltar para Notícias
              </a>
            </p>
            <h1 class="news-title" id="news-title"><%= news.title %></h1>
            <p class="news-autor text-muted" id="news-author-date">Por <%= news.author %> - <%= news.date %></p>

            <% if (news.mainImageUrl) { %>
                <div class="text-center my-4">
                    <div class="ratio ratio-16x9 mx-auto" style="max-width: 640px">
                         <img src="<%= news.mainImageUrl %>" alt="Imagem principal de <%= news.title %>" class="rounded news-image-in-ratio" id="news-main-image" />
                    </div>
                </div>
                <% if (news.mainImageCaption) { %><p class="img-leg text-center" id="news-main-caption"><%= news.mainImageCaption %></p><% } %>
            <% } %>
            
            <article class="news-article-body mt-4" id="news-article-content">
                <%- news.articleContent %> </article>

            <div id="news-secondary-content" class="my-4">
                <% if (news.videoUrl) { %>
                    <div class="text-center">
                        <div class="ratio ratio-16x9 mx-auto" style="max-width: 720px;">
                            <iframe src="<%= news.videoUrl.replace('watch?v=', 'embed/') %>" title="Vídeo da Notícia: <%= news.title %>" allowfullscreen class="rounded"></iframe>
                        </div>
                        <% if (news.videoCaption) { %><p class="img-leg mt-2 text-center"><%= news.videoCaption %></p><% } %>
                    </div>
                <% } else if (news.secondaryImageUrl) { %>
                     <div class="text-center">
                        <img src="<%= news.secondaryImageUrl %>" alt="Imagem secundária de <%= news.title %>" class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto; max-height: 400px; object-fit: contain;">
                         <% if (news.secondaryImageCaption) { %><p class="img-leg mt-2 text-center"><%= news.secondaryImageCaption %></p><% } %>
                    </div>
                <% } %>
            </div>
        </section>

        <div class="news-section-divider"></div>

        <section class="also">
          <h2 class="section-also-title">Veja também...</h2>
          <div class="container py-4">
            <div class="row gy-4" id="related-news-row">
                <% if (relatedNews && relatedNews.length > 0) { %>
                    <% relatedNews.forEach(related => { %>
                        <div class="col-md-6 mb-4">
                             <div class="card bg-dark text-light h-100">
                                <a href="/news/<%= related.id %>">
                                    <img src="<%= related.mainImageUrl || '/assets/img/placeholder_news.webp' %>" class="card-img-top" alt="<%= related.title %>">
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <a href="/news/<%= related.id %>" class="text-decoration-none text-light">
                                        <h5 class="card-title fw-bold"><%= related.title %></h5>
                                    </a>
                                    <p class="card-text">
                                        <% if(related.summary) { %>
                                            <%= related.summary.length > 80 ? related.summary.substring(0, 77) + "..." : related.summary %>
                                        <% } %>
                                    </p> 
                                    <a href="/news/<%= related.id %>" class="btn btn-outline-light mt-auto">Ver Mais</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-light text-center col-12">Nenhuma notícia relacionada encontrada.</p>
                <% } %>
            </div>
          </div>
        </section>
      <% } else { %>
        <p class="text-center text-light display-6 mt-5 pt-5">Notícia não encontrada.</p>
      <% } %>
    </main>
<%- include('partials/footer', { pageScript: '' }) %>