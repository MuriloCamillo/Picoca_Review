<%- include('partials/header', { 
    title: title, 
    pageStyle: 'series_gallery.css', 
    bodyClass: 'series-body',
    metaDescription: 'Encontre todas as suas séries favoritas no Picoca Review. Explore por gênero, busque por título e descubra novas séries para assistir.'
}) %>
    <main class="container my-1">
      <h1 class="main-title mt-5 pt-4">Séries</h1>
      <h2 class="main-subtitle">
        Procure por suas séries e saiba mais clicando nelas.
      </h2>
      <div class="section-divider"></div>

      <div class="filter-search-container d-flex flex-wrap justify-content-center align-items-baseline my-4">
        <div id="myBtnContainer" class="menu-filter me-md-3 mb-3 mb-md-0">
          <button class="btn filter-btn active" data-filter="all" role="button">Mostrar Todas</button>
          <button class="btn filter-btn" data-filter="comedia" role="button">Comédia</button>
          <button class="btn filter-btn" data-filter="drama" role="button">Drama</button>
          <button class="btn filter-btn" data-filter="animacao" role="button">Animação</button>
          <button class="btn filter-btn" data-filter="acao" role="button">Ação</button>
          <button class="btn filter-btn" data-filter="ficcao" role="button">Ficção</button>
          <button class="btn filter-btn" data-filter="terror" role="button">Terror</button>
          <button class="btn filter-btn" data-filter="misterio" role="button">Mistério</button>
          <button class="btn filter-btn" data-filter="sci-fi" role="button">Sci-Fi</button>
        </div>

        <div class="search-series-container local-search-container">
          <input
            type="search"
            id="seriesSearchInput"
            class="form-control"
            placeholder="Buscar por título na galeria..."
            value="<%= typeof searchQuery === 'string' ? searchQuery : '' %>" />
          <span class="local-search-icon">
            <i class="bi bi-search"></i>
          </span>
        </div>
      </div>

      <div class="row gy-4 justify-content-center" id="seriesList">
        <% if (seriesItems && seriesItems.length > 0) { %>
            <% seriesItems.forEach(serie => { %>
                <% 
                const normalizeGenreForClass = (genreName) => { // Função de normalização de gênero do seu JS original
                    if (!genreName) return "";
                    let normalized = genreName.toLowerCase();
                    normalized = normalized.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                    const genreMap = {
                        'comédia': 'comedia', 'drama': 'drama', 'animação': 'animacao', 'ação': 'acao',
                        'ficção científica': 'ficcao', 'ficcao cientifica': 'ficcao', 'ficção': 'ficcao',
                        'terror': 'terror', 'mistério': 'misterio', 'misterio': 'misterio', 'crime': 'crime',
                        'policial': 'policial', 'aventura': 'aventura', 'super heróis': 'acao', 
                        'pós-apocalíptico': 'ficcao', 'sci-fi': 'sci-fi', 'Sci-Fi': 'sci-fi'
                    };
                    for (const key in genreMap) { if (normalized.includes(key)) return genreMap[key]; }
                    return normalized.replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").split("-")[0];
                };
                const genreClasses = (serie.genres || [])
                    .map(normalizeGenreForClass)
                    .filter((cls, index, self) => cls && self.indexOf(cls) === index)
                    .join(" ");
                %>
                <div class="col-lg-2 col-md-3 col-sm-4 col-6 filterDiv <%= genreClasses %>">
                    <a href="/series/<%= serie.id %>" class="poster-link">
                        <div class="poster">
                            <img src="<%= serie.posterImg || '/assets/img/placeholder_poster.webp' %>" alt="<%= serie.title %>">
                        </div>
                    </a>
                </div>
            <% }); %>
        <% } else { %>
            <p class="text-light col-12 text-center display-6 mt-5">Nenhuma série encontrada.</p>
        <% } %>
      </div>
    </main>
<%- include('partials/footer', { pageScript: 'series_gallery_filter.js' }) %>