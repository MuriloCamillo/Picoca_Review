<%- include('partials/header', { 
    title: title, 
    pageStyle: 'journal.css', 
    bodyClass: 'journal-body',
    metaDescription: 'Fique por dentro das últimas notícias do mundo do entretenimento no Picoca Review. Novidades sobre suas séries e filmes favoritos, lançamentos e muito mais.'
}) %>
    <main class="container py-4"> <h1 class="main-title mt-5">Notícias</h1> <h2 class="main-subtitle">Últimas novidades do mundo cinematográfico.</h2>
      <div class="section-divider"></div>
      <div class="container py-4"> <div class="row gy-4" id="journal-cards-row"> <% if (newsItems && newsItems.length > 0) { %>
                <% newsItems.forEach(newsItem => { %>
                    <div class="col-md-6 col-lg-4 mb-4"> <div class="card bg-dark text-light h-100">
                            <a href="/news/<%= newsItem.id %>">
                                <img src="<%= newsItem.mainImageUrl || '/assets/img/placeholder_news.webp' %>" class="card-img-top" alt="Imagem da notícia <%= newsItem.title %>">
                            </a>
                            <div class="card-body d-flex flex-column">
                                <a href="/news/<%= newsItem.id %>" class="text-decoration-none text-light">
                                    <h5 class="card-title fw-bold"><%= newsItem.title %></h5>
                                </a>
                                <p class="card-text">
                                    <% if (newsItem.summary) { %>
                                        <%= newsItem.summary.length > 100 ? newsItem.summary.substring(0, 97) + "..." : newsItem.summary %>
                                    <% } %>
                                </p>
                                <a href="/news/<%= newsItem.id %>" class="btn btn-outline-light mt-auto">Ver Mais</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-light col-12 text-center">Nenhuma notícia cadastrada no momento.</p>
            <% } %>
        </div>
      </div>
    </main>
<%- include('partials/footer', { pageScript: '' }) %>