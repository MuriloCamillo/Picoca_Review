<%- include('partials/header', { 
    title: title, 
    pageStyle: 'profile.css', 
    bodyClass: 'profile-body',
    metaDescription: user ? `Perfil de ${user.username} no Picoca Review. Gerencie suas informações e listas.` : 'Configurações da Conta - Picoca Review'
}) %>

<main class="container mt-4 mb-5">
    <h1 class="profile-title mb-4 mt-5 pt-4">Configurações da conta</h1>

    <% if (user) { %>
        <ul class="nav nav-tabs profile-tabs mb-4" id="profileTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-content-pane" type="button" role="tab" aria-controls="profile-content-pane" aria-selected="true">
                    <i class="bi bi-person-fill me-1"></i> Perfil
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-content-pane" type="button" role="tab" aria-controls="password-content-pane" aria-selected="false">
                    <i class="bi bi-key-fill me-1"></i> Senha
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="avatar-tab" data-bs-toggle="tab" data-bs-target="#avatar-content-pane" type="button" role="tab" aria-controls="avatar-content-pane" aria-selected="false">
                    <i class="bi bi-image-fill me-1"></i> Avatar
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
            <div class="tab-pane fade show active" id="profile-content-pane" role="tabpanel" aria-labelledby="profile-tab">
                <form action="/profile/update" method="POST" class="profile-form needs-validation-profile" novalidate>
                    <h4 class="mb-4">Informações do Perfil</h4>
                    <% if (locals.error_profile) { %><div class="alert alert-danger alert-dismissible fade show"><%= error_profile %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
                    <% if (locals.success_profile) { %><div class="alert alert-success alert-dismissible fade show"><%= success_profile %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="profileFirstName" class="form-label">Primeiro Nome</label>
                            <input type="text" class="form-control" id="profileFirstName" name="firstName" value="<%= user.firstName || '' %>" required>
                            <div class="invalid-feedback">Por favor, insira seu nome.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="profileLastName" class="form-label">Sobrenome</label>
                            <input type="text" class="form-control" id="profileLastName" name="lastName" value="<%= user.lastName || '' %>" required>
                            <div class="invalid-feedback">Por favor, insira seu sobrenome.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="profileUsername" class="form-label">Nome de Usuário</label>
                            <div class="input-group has-validation">
                                <span class="input-group-text">@</span>
                                <input type="text" class="form-control" id="profileUsername" name="username" value="<%= user.username %>" required pattern="^[a-zA-Z0-9_]{3,20}$" title="Usuário deve ter 3-20 caracteres (letras, números, underscore).">
                                <div class="invalid-feedback">Usuário inválido (3-20 caracteres, letras, números, _).</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="profileEmail" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="profileEmail" name="email" value="<%= user.email %>" required>
                            <div class="invalid-feedback">Por favor, insira um e-mail válido.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="profileCountry" class="form-label">País</label>
                            <select class="form-select" id="profileCountry" name="country" required> {/* Adicionado 'required' ao select */}
                                {/* Opção placeholder desabilitada e selecionada se não houver país */}
                                <option value="" disabled <%= !(user.country && user.country.trim() !== '') ? 'selected' : '' %>>Selecione seu país...</option>
                                
                                <% if (typeof countriesList !== 'undefined' && countriesList.length > 0) { %>
                                    <% countriesList.forEach(function(countryOption) { %>
                                        <% if (countryOption.code) { // Pula a opção "Selecione seu país" da lista, se ela estiver lá com code="" %>
                                            <option value="<%= countryOption.code %>" <%= user.country === countryOption.code ? 'selected' : '' %>>
                                                <%= countryOption.name %>
                                            </option>
                                        <% } %>
                                    <% }); %>
                                <% } else { %>
                                     {/* Fallback caso countriesList não seja passada, mas a opção placeholder já cobre isso */}
                                <% } %>
                            </select>
                            <div class="invalid-feedback">Por favor, selecione seu país.</div> 
                        </div>
                        <div class="col-12">
                            <label for="profileBio" class="form-label">Bio</label>
                            <textarea class="form-control" id="profileBio" name="bio" rows="3" placeholder="Fale um pouco sobre você..."><%= user.bio || '' %></textarea>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <button type="submit" class="btn profile-btn">Salvar Alterações</button>
                    </div>
                </form>
            </div>
            
            <div class="tab-pane fade" id="password-content-pane" role="tabpanel" aria-labelledby="password-tab">
                <form action="/profile/change-password" method="POST" class="profile-form needs-validation-password" novalidate>
                    <h4 class="mb-4">Alterar Senha</h4>
                    <% if (locals.error_password) { %><div class="alert alert-danger alert-dismissible fade show"><%= error_password %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
                    <% if (locals.success_password) { %><div class="alert alert-success alert-dismissible fade show"><%= success_password %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
                    
                    <div class="row g-3 justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <label for="currentPassword" class="form-label">Senha Atual</label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder="Sua senha atual" required>
                            <div class="invalid-feedback">Por favor, insira sua senha atual.</div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-8 col-lg-6">
                            <label for="newPassword" class="form-label">Nova Senha</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="Mínimo 8 caracteres" required minlength="8">
                            <div class="invalid-feedback" id="newPasswordFeedback">A nova senha deve ter no mínimo 8 caracteres.</div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-8 col-lg-6">
                            <label for="confirmNewPassword" class="form-label">Confirmar Nova Senha</label>
                            <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" placeholder="Repita a nova senha" required>
                            <div class="invalid-feedback" id="confirmNewPasswordFeedback">As senhas não correspondem.</div>
                        </div>
                    </div>
                    <div class="mt-4 text-center">
                        <button type="submit" class="btn profile-btn">Alterar Senha</button>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="avatar-content-pane" role="tabpanel" aria-labelledby="avatar-tab">
                <div class="avatar-section text-center profile-form">
                    <h4 class="mb-3">Seu Avatar Atual</h4>
                    <div class="current-avatar mb-4">
                        <img src="<%= user.avatarUrl || '/assets/img/avatars/default_avatar.png' %>" 
                             alt="Avatar Atual"
                             id="avatarPreview" 
                             class="rounded-circle img-thumbnail" 
                             style="width: 150px; height: 150px; object-fit: cover;">
                    </div>
                    
                    <h5 class="mb-3">Alterar Avatar</h5>
                    <% if (locals.error_avatar) { %><div class="alert alert-danger alert-dismissible fade show"><%= error_avatar %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
                    <% if (locals.success_avatar) { %><div class="alert alert-success alert-dismissible fade show"><%= success_avatar %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

                    <form action="/profile/avatar" method="POST" enctype="multipart/form-data" id="avatarForm" class="needs-validation-avatar" novalidate>
                        <div class="mb-3 mx-auto" style="max-width: 400px;">
                            <label for="avatarFile" class="form-label visually-hidden">Escolher novo avatar</label>
                            <input class="form-control" type="file" id="avatarFile" name="avatarFile" accept="image/png, image/jpeg, image/gif, image/webp" required>
                            <div class="invalid-feedback" id="avatarFileFeedback">Por favor, selecione uma imagem (png, jpg, gif, webp).</div>
                        </div>
                        <p class="avatar-hint mt-2 mb-3">Tamanho máximo: 2MB. Formatos: PNG, JPG, GIF, WEBP.</p>
                        <button type="submit" class="btn profile-btn"><i class="bi bi-upload me-2"></i>Enviar Novo Avatar</button>
                    </form>
                </div>
            </div>
        </div>
    <% } else { %>
        <p class="text-center display-6 mt-5 pt-5">Por favor, <a href="/login">faça login</a> para acessar seu perfil.</p>
    <% } %>
</main>

<%- include('partials/footer') %> 

<script src="/assets/js/profile_tabs.js" defer></script>
<script src="/assets/js/profile_validation.js" defer></script>