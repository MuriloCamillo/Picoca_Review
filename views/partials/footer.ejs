<script>
    // Script para inicializar toasts do Bootstrap 5 que podem ser mostrados condicionalmente
    document.addEventListener('DOMContentLoaded', function () {
        var toastElList = [].slice.call(document.querySelectorAll('.toast.show[data-bs-delay]'));
        toastElList.forEach(function (toastEl) {
            // O Bootstrap inicializa e mostra automaticamente toasts com .show e data-bs-delay.
            // Esta linha garante que o objeto Toast exista caso você queira manipulá-lo via JS depois.
            var toast = new bootstrap.Toast(toastEl); 
            // Se o toast foi adicionado dinamicamente e precisa ser mostrado explicitamente:
            // if (!toastEl.classList.contains('showing') && !toastEl.classList.contains('show')) {
            //    toast.show();
            // }
        });
    });
</script>

