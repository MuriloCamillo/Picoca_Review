<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="<%= typeof metaDescription === 'string' ? metaDescription : 'Picoca Review: Descubra e organize as suas séries favoritas, acompanhe as últimas notícias e encontre onde assistir.' %>"
    />
    <title><%= typeof title === 'string' ? title : 'Picoca Review' %></title>
    <link
      rel="icon"
      type="image/x-icon"
      href="/assets/img/index/frog-popcorn.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oxygen:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <link rel="stylesheet" href="/assets/styles/global.css">
    <link rel="stylesheet" href="/assets/styles/nav.css">
    
    <% if (typeof pageStyle === 'string' && pageStyle) { %>
        <link rel="stylesheet" href="/assets/styles/<%= pageStyle %>">
    <% } %>
</head>
<body class="<%= typeof bodyClass === 'string' ? bodyClass : '' %>">
    <header>
        <%- include('navbar', { 
            user: typeof user !== 'undefined' ? user : null, 
            title: typeof title !== 'undefined' ? title : '', 
            searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '',
            login_success: typeof login_success !== 'undefined' ? login_success : '', 
            signup_success: typeof signup_success !== 'undefined' ? signup_success : '', 
            logout_success: typeof logout_success !== 'undefined' ? logout_success : '', 
            logout_error: typeof logout_error !== 'undefined' ? logout_error : '',
            error: typeof error !== 'undefined' ? error : '' 
        }) %>
    </header>